{
  "manifest_version": 3,
  "name": "Markdown 查看器",
  "version": "1.0.0",
  "description": "在浏览器中优雅地查看 Markdown 文件，支持 GFM、代码高亮、Mermaid 图表和 KaTeX 数学公式。",
  "minimum_chrome_version": "118",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Markdown 查看器",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*.md*",
        "https://*/*.md*",
        "http://*/*.Md*",
        "https://*/*.Md*",
        "http://*/*.mD*",
        "https://*/*.mD*",
        "http://*/*.MD*",
        "https://*/*.MD*",
        "http://*/*.markdown*",
        "https://*/*.markdown*",
        "http://*/*.MARKDOWN*",
        "https://*/*.MARKDOWN*",
        "http://*/*.mdown*",
        "https://*/*.mdown*",
        "http://*/*.MDOWN*",
        "https://*/*.MDOWN*",
        "http://*/*.mkd*",
        "https://*/*.mkd*",
        "http://*/*.MKD*",
        "https://*/*.MKD*",
        "file:///*.md*",
        "file:///*.Md*",
        "file:///*.mD*",
        "file:///*.MD*",
        "file:///*.markdown*",
        "file:///*.MARKDOWN*",
        "file:///*.mdown*",
        "file:///*.MDOWN*",
        "file:///*.mkd*",
        "file:///*.MKD*"
      ],
      "exclude_matches": [
        "*://github.com/*",
        "*://*.github.com/*",
        "*://gitlab.com/*/-/blob/*",
        "*://*.gitlab.com/*/-/blob/*",
        "*://gitlab.com/*/blob/*",
        "*://*.gitlab.com/*/blob/*",
        "*://bitbucket.org/*/src/*",
        "*://*.bitbucket.org/*/src/*",
        "*://codeberg.org/*/src/*",
        "*://gitea.com/*/src/*"
      ],
      "js": [
        "vendor/marked.umd.js",
        "vendor/highlight.min.js",
        "vendor/purify.min.js",
        "vendor/katex.min.js",
        "vendor/mermaid.min.js",
        "src/shared/render.js",
        "src/content/content.js"
      ],
      "css": [
        "vendor/github-markdown.css",
        "vendor/hljs.css",
        "vendor/katex.min.css",
        "src/shared/mdv.css",
        "src/content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
