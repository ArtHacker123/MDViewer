{
  "name": "mdviewer-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that renders Markdown files with GFM, syntax highlighting, Mermaid diagrams and KaTeX math.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-vendor.mjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "test": "node scripts/test-render.mjs",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack.ps1"
  },
  "keywords": [
    "chrome-extension",
    "markdown",
    "mermaid",
    "katex"
  ],
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0"
  }
}
